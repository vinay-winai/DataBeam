{
  "id": "com.vinaywinai.databeam",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "databeam",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=home",
    "--filesystem=/run/media",
    "--filesystem=/media",
    "--filesystem=/mnt",
    "--filesystem=/sdcard",
    "--filesystem=/storage"
  ],
  "modules": [
    {
      "name": "databeam",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 databeam /app/bin/databeam",
        "install -Dm644 com.vinaywinai.databeam.desktop /app/share/applications/com.vinaywinai.databeam.desktop",
        "install -Dm644 com.vinaywinai.databeam.metainfo.xml /app/share/metainfo/com.vinaywinai.databeam.metainfo.xml",
        "install -Dm644 icon-512.png /app/share/icons/hicolor/512x512/apps/com.vinaywinai.databeam.png",
        "install -Dm644 LICENSE /app/share/licenses/com.vinaywinai.databeam/LICENSE",
        "install -Dm644 THIRD_PARTY_NOTICES.md /app/share/licenses/com.vinaywinai.databeam/THIRD_PARTY_NOTICES.md",
        "cp -r LICENSES /app/share/licenses/com.vinaywinai.databeam/"
      ],
      "sources": [{ "type": "dir", "path": "payload" }]
    }
  ]
}
