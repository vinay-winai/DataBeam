@@ -0,0 +1,35 @@
+package utils
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDataBeamHashProgressUsesReadBytesAndPreservesCancellation(t *testing.T) {
+	name := filepath.Join(t.TempDir(), "data")
+	data := bytes.Repeat([]byte{0x31}, 1024*1024)
+	if err := os.WriteFile(name, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	var previous int64
+	ctx := WithHashProgress(context.Background(), func(offset int64) {
+		if offset < previous || offset > int64(len(data)) {
+			t.Fatalf("bad offset %d", offset)
+		}
+		previous = offset
+	})
+	if _, err := HashFileCtx(ctx, name, "xxhash"); err != nil {
+		t.Fatal(err)
+	}
+	if previous != int64(len(data)) {
+		t.Fatalf("missing read progress: %d", previous)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	ctx = WithHashProgress(ctx, func(_ int64) { cancel() })
+	if _, err := HashFileCtx(ctx, name, "xxhash"); err == nil {
+		t.Fatal("cancellation ignored")
+	}
+}
