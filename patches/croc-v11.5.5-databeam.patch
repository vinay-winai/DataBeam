+package croc
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/schollz/croc/v11/src/comm"
+	"github.com/schollz/croc/v11/src/utils"
+)
+
+func TestDataBeamLocalProbeAllowsRelayLatency(t *testing.T) {
+	left, right := net.Pipe()
+	reader, writer := comm.New(left), comm.New(right)
+	defer reader.Close()
+	defer writer.Close()
+	done := make(chan error, 1)
+	go func() {
+		if err := writer.Send([]byte{1}); err != nil {
+			done <- err
+			return
+		}
+		// A slow relay/VPN can exceed the upstream 500 ms control deadline.
+		time.Sleep(750 * time.Millisecond)
+		done <- writer.Send([]byte("delayed PAKE response"))
+	}()
+	got, err := receiveControlFrame(reader)
+	if err != nil || string(got) != "delayed PAKE response" {
+		t.Fatalf("delayed probe = %q, %v", got, err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDataBeamValidatedTextDoesNotPromptForItsOwnTempFile(t *testing.T) {
+	t.Chdir(t.TempDir())
+	name, err := utils.RandomFileName()
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous := receiveOverwriteInput
+	receiveOverwriteInput = func(context.Context, string) (string, error) {
+		t.Error("validated text prompted to overwrite its receiver-created temp file")
+		return "n", nil
+	}
+	t.Cleanup(func() { receiveOverwriteInput = previous })
+	client := overwriteTestClient(t, FileInfo{
+		Name: name, FolderRemote: ".", Size: 32, Mode: 0o600,
+	}, Options{SendingText: true, NoPrompt: true, HashAlgorithm: defaultHashAlgorithm})
+	if err := client.updateIfRecipientHasFileInfo(); err != nil {
+		t.Fatal(err)
+	}
+	if client.FilesToTransfer[0].declined {
+		t.Fatal("receiver declined its validated text payload")
+	}
+}
