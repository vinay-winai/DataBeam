+
+func TestDataBeamPreparationTracksSelectionWithoutDoubleCounting(t *testing.T) {
+	var output bytes.Buffer
+	p := newDataBeamPreparation([]FileInfo{{Name: "dup", Size: 1000}, {Name: "dup", Size: 3000}, {Name: "small", Size: 100}, {Name: "empty", Size: 0}}, &output)
+	p.advance(0, 1000)
+	p.advance(0, 1000)
+	p.advance(1, 1500)
+	p.advance(1, 1000)
+	if p.completed != 2500 || p.total != 4100 {
+		t.Fatalf("wrong overall bytes: %d / %d", p.completed, p.total)
+	}
+	p.advance(1, 5000)
+	p.advance(2, 100)
+	lines := strings.Split(strings.TrimSpace(output.String()), "\n")
+	last := strings.TrimPrefix(lines[len(lines)-1], "DATABEAM_PREPARE_V1 ")
+	var event struct {
+		Done, Total int64
+		Speed       float64 `json:"speed_bps"`
+	}
+	if err := json.Unmarshal([]byte(last), &event); err != nil {
+		t.Fatal(err)
+	}
+	if event.Done != 4100 || event.Total != 4100 {
+		t.Fatalf("bad final event: %+v", event)
+	}
+}
+
+func TestDataBeamPreparationDoesNotChangeHashes(t *testing.T) {
+	t.Setenv("DATABEAM_CROC_PROGRESS", "1")
+	directory := t.TempDir()
+	files := []FileInfo{}
+	for _, item := range []struct {
+		name string
+		size int
+	}{{"a", 1024 * 1024}, {"b", 8192}, {"empty", 0}} {
+		name := filepath.Join(directory, item.name)
+		if err := os.WriteFile(name, bytes.Repeat([]byte{0x53}, item.size), 0600); err != nil {
+			t.Fatal(err)
+		}
+		info, err := os.Stat(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		files = append(files, FileInfo{Name: item.name, FolderSource: directory, Size: info.Size(), ModTime: info.ModTime(), Mode: info.Mode()})
+	}
+	client := &Client{stop: newStop(context.Background()), Options: Options{IsSender: true, NoCompress: true}}
+	if err := client.sendCollectFiles(files); err != nil {
+		t.Fatal(err)
+	}
+	if client.dataBeamPreparation.completed != 1024*1024+8192 {
+		t.Fatal("small files missing from total")
+	}
+	for _, file := range client.FilesToTransfer {
+		expected, err := utils.HashFileCtx(context.Background(), filepath.Join(directory, file.Name), defaultHashAlgorithm)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(expected, file.Hash) {
+			t.Fatalf("hash changed for %s", file.Name)
+		}
+	}
+}
+
+func TestDataBeamRatePublishesWindowedWireBytes(t *testing.T) {
+	var output bytes.Buffer
+	start := time.Now().Add(-500 * time.Millisecond)
+	rate := &dataBeamRate{last: start, bytes: 1000, writer: &output}
+	rate.window.observe(0, start)
+	rate.add(1000)
+	var value struct {
+		Speed float64 `json:"speed_bps"`
+	}
+	line := strings.TrimPrefix(strings.TrimSpace(output.String()), "DATABEAM_RATE_V1 ")
+	if err := json.Unmarshal([]byte(line), &value); err != nil {
+		t.Fatal(err)
+	}
+	if value.Speed < 3900 || value.Speed > 4100 {
+		t.Fatalf("bad first rate: %f", value.Speed)
+	}
+	if rate.bytes != 2000 {
+		t.Fatalf("wire count was reset: %d", rate.bytes)
+	}
+
+}
+
+func TestDataBeamRateWindowSmoothsBurstsAndExpiresOldData(t *testing.T) {
+	start := time.Unix(100, 0)
+	var window dataBeamRateWindow
+	window.observe(1000000, start) // Resumed bytes are the initial baseline.
+	if got := window.observe(1010000, start.Add(100*time.Millisecond)); got != 100000 {
+		t.Fatalf("initial rate: %f", got)
+	}
+	if got := window.observe(1011000, start.Add(200*time.Millisecond)); got != 55000 {
+		t.Fatalf("burst was not smoothed: %f", got)
+	}
+	window.observe(1011000, start.Add(300*time.Millisecond))
+	for tick := int64(4); tick <= 13; tick++ {
+		got := window.observe(1011000+(tick-3)*1000, start.Add(time.Duration(tick)*100*time.Millisecond))
+		if tick == 13 && got != 10000 {
+			t.Fatalf("old burst did not expire: %f", got)
+		}
+	}
+}
+
+func TestDataBeamRateWindowWeightsIrregularIntervalsAndResetsAfterIdle(t *testing.T) {
+	start := time.Unix(100, 0)
+	var window dataBeamRateWindow
+	window.observe(0, start)
+	for _, sample := range []struct{ ms, bytes int64 }{{100, 10000}, {350, 35000}, {1050, 105000}} {
+		if got := window.observe(sample.bytes, start.Add(time.Duration(sample.ms)*time.Millisecond)); got != 100000 {
+			t.Fatalf("irregular interval rate: %f", got)
+		}
+	}
+	if got := window.observe(105000, start.Add(3*time.Second)); got != 0 {
+		t.Fatalf("idle rate: %f", got)
+	}
+	if got := window.observe(105100, start.Add(3100*time.Millisecond)); got != 1000 {
+		t.Fatalf("rate after idle: %f", got)
+	}
+	if got := window.observe(0, start.Add(3200*time.Millisecond)); got != 0 {
+		t.Fatalf("reset rate: %f", got)
+	}
+	for tick := int64(33); tick <= 1000; tick++ {
+		window.observe((tick-32)*100, start.Add(time.Duration(tick)*100*time.Millisecond))
+		if len(window.points) > 12 {
+			t.Fatalf("unbounded rate history: %d", len(window.points))
+		}
+	}
+}
+
+func TestDataBeamRateWindowSupportsSlowUpdates(t *testing.T) {
+	start := time.Unix(100, 0)
+	var window dataBeamRateWindow
+	window.observe(0, start)
+	if got := window.observe(2000, start.Add(2*time.Second)); got != 1000 {
+		t.Fatalf("slow rate: %f", got)
+	}
+	if got := window.observe(4000, start.Add(4*time.Second)); got != 1000 {
+		t.Fatalf("repeated slow rate: %f", got)
+	}
+}
