+package croc
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"sync"
+	"time"
+)
+
+// Count only bytes actually sent/received, never resume/skipped bytes added
+// to the terminal's progress bar. Average over the trailing second.
+type dataBeamRate struct {
+	mu     sync.Mutex
+	last   time.Time
+	bytes  int64
+	window dataBeamRateWindow
+	writer io.Writer
+}
+
+func (r *dataBeamRate) add(n int64) {
+	if n <= 0 {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	now := time.Now()
+	r.bytes += n
+	if r.last.IsZero() {
+		r.last = now
+		r.window.observe(0, now)
+		return
+	}
+	seconds := now.Sub(r.last).Seconds()
+	if seconds < 0.1 {
+		return
+	}
+	data, err := json.Marshal(struct {
+		Speed float64 `json:"speed_bps"`
+	}{r.window.observe(r.bytes, now)})
+	if err == nil {
+		fmt.Fprintf(r.writer, "\nDATABEAM_RATE_V1 %s\n", data)
+	}
+	r.last = now
+}
+
+type dataBeamRatePoint struct {
+	at    time.Time
+	bytes int64
+}
+
+// Local measurements are time weighted, with interpolation at the window
+// boundary so uneven update intervals do not bias the displayed rate.
+type dataBeamRateWindow struct {
+	points []dataBeamRatePoint
+}
+
+func (w *dataBeamRateWindow) observe(bytes int64, now time.Time) float64 {
+	if len(w.points) == 0 {
+		w.points = append(w.points, dataBeamRatePoint{now, bytes})
+		return 0
+	}
+	last := w.points[len(w.points)-1]
+	if bytes < last.bytes || now.Before(last.at) {
+		w.points = []dataBeamRatePoint{{now, bytes}}
+		return 0
+	}
+	if now.Sub(last.at) >= time.Second && bytes == last.bytes {
+		w.points = []dataBeamRatePoint{{now, last.bytes}}
+		return 0
+	}
+	if !now.After(last.at) {
+		return 0
+	}
+	w.points = append(w.points, dataBeamRatePoint{now, bytes})
+	cutoff := now.Add(-time.Second)
+	for len(w.points) > 1 && !w.points[1].at.After(cutoff) {
+		w.points = w.points[1:]
+	}
+	first := w.points[0]
+	start := first.at
+	delta := float64(bytes - first.bytes)
+	if start.Before(cutoff) {
+		start = cutoff
+		next := w.points[1]
+		fraction := start.Sub(first.at).Seconds() / next.at.Sub(first.at).Seconds()
+		delta -= float64(next.bytes-first.bytes) * fraction
+	}
+	return delta / now.Sub(start).Seconds()
+}
+
+// Local GUI telemetry only. These counters never enter the transfer protocol.
+type dataBeamPreparation struct {
+	mu        sync.Mutex
+	sizes     []int64
+	done      []int64
+	total     int64
+	completed int64
+	last      time.Time
+	rate      dataBeamRateWindow
+	writer    io.Writer
+}
+
+func newDataBeamPreparation(files []FileInfo, writer io.Writer) *dataBeamPreparation {
+	p := &dataBeamPreparation{sizes: make([]int64, len(files)), done: make([]int64, len(files)), writer: writer}
+	for i, file := range files {
+		if file.Size > 0 {
+			p.sizes[i] = file.Size
+			p.total += file.Size
+		}
+	}
+	p.emit(true)
+	return p
+}
+
+func (p *dataBeamPreparation) advance(index int, offset int64) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if index < 0 || index >= len(p.sizes) {
+		return
+	}
+	if offset > p.sizes[index] {
+		offset = p.sizes[index]
+	}
+	if offset <= p.done[index] {
+		return
+	}
+	p.completed += offset - p.done[index]
+	p.done[index] = offset
+	p.emit(p.completed == p.total)
+}
+
+func (p *dataBeamPreparation) emit(force bool) {
+	now := time.Now()
+	if !force && !p.last.IsZero() && now.Sub(p.last) < 100*time.Millisecond {
+		return
+	}
+	rate := p.rate.observe(p.completed, now)
+	p.last = now
+	value := struct {
+		Done  int64   `json:"done"`
+		Total int64   `json:"total"`
+		Speed float64 `json:"speed_bps"`
+	}{p.completed, p.total, rate}
+	data, err := json.Marshal(value)
+	if err == nil {
+		fmt.Fprintf(p.writer, "\nDATABEAM_PREPARE_V1 %s\n", data)
+	}
+}
