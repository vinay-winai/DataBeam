+package utils
+
+import (
+    "os"
+    "path/filepath"
+    "runtime"
+    "strconv"
+    "strings"
+)
+
+// Only the Android recipe applies this adapter. Only named descriptors beneath
+// the declared private source tree represent regular bytes, not symlink text.
+func DataBeamSourceStat(path string) (os.FileInfo, error) {
+    if runtime.GOOS == "android" {
+        root := os.Getenv("DATABEAM_ANDROID_SOURCE_ROOT")
+        if filepath.IsAbs(root) {
+            abs, err := filepath.Abs(path)
+            rel, relErr := filepath.Rel(filepath.Clean(root), abs)
+            if err == nil && relErr == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(os.PathSeparator)) {
+                target, linkErr := os.Readlink(abs)
+                prefix := "/proc/"+strconv.Itoa(os.Getppid())+"/fd/"
+                if linkErr == nil && strings.HasPrefix(target, prefix) {
+                    fd, parseErr := strconv.Atoi(strings.TrimPrefix(target, prefix))
+                    if parseErr == nil && fd >= 0 {
+                        info, statErr := os.Stat(abs)
+                        if statErr != nil { return nil, statErr }
+                        if info.Mode().IsRegular() { return info, nil }
+                    }
+                }
+            }
+        }
+    }
+    return os.Lstat(path)
+}
