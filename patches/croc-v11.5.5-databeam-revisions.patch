+package croc
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/schollz/croc/v11/src/receivefs"
+)
+
+func revisionItem(name, contents string) managedItem {
+	hash := sha256.Sum256([]byte(contents))
+	return managedItem{Path: name, Kind: "file", Size: int64(len(contents)), Digest: hash[:]}
+}
+
+func TestDataBeamRevisionRecovery(t *testing.T) {
+	t.Setenv("DATABEAM_CROC_DOWNLOAD_MAP", "")
+	keep := revisionItem("keep.bin", "unchanged")
+	old := managedReceipt{Version: 1, Strong: true, Algorithm: "sha256", Entries: []managedItem{
+		keep, revisionItem("updated.bin", "old"), revisionItem("folder/removed.bin", "old"),
+	}}
+	next := managedReceipt{Version: 1, Strong: true, Algorithm: "sha256", Entries: []managedItem{
+		keep, revisionItem("updated.bin", "new"), revisionItem("renamed.bin", "old"),
+	}}
+	review, retired, dirs := diffManagedOffers(old, next)
+	if !reflect.DeepEqual(review.Replaced, []string{"updated.bin"}) ||
+		!reflect.DeepEqual(review.Added, []string{"renamed.bin"}) ||
+		!reflect.DeepEqual(review.Removed, []string{"folder", "folder/removed.bin"}) {
+		t.Fatalf("wrong review: %+v", review)
+	}
+	destination := t.TempDir()
+	receipt := filepath.Join(t.TempDir(), "receipt")
+	write := func(name, contents string) {
+		t.Helper()
+		full := filepath.Join(destination, name)
+		if err := os.MkdirAll(filepath.Dir(full), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte(contents), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("keep.bin", "partial")
+	write("updated.bin", "old")
+	write("folder/removed.bin", "old")
+	if err := writeManagedJSON(receipt, old); err != nil {
+		t.Fatal(err)
+	}
+	update := managedRevision{ID: "example", Previous: old, Next: next, Files: retired, Dirs: dirs}
+	if err := writeManagedJSON(receipt+".revision", update); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(destination, "updated.bin")); err != nil {
+		t.Fatal(err)
+	}
+	root, err := receivefs.OpenRoot(destination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Close()
+	c := &Client{receiveRoot: root}
+	input := bufio.NewReader(strings.NewReader(""))
+	if err := c.finishManagedRevision(receipt, input); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(destination, "folder")); !os.IsNotExist(err) {
+		t.Fatalf("retired directory remains: %v", err)
+	}
+	kept, err := os.ReadFile(filepath.Join(destination, "keep.bin"))
+	if err != nil || !bytes.Equal(kept, []byte("partial")) {
+		t.Fatalf("partial data was lost: %q, %v", kept, err)
+	}
+	// The commit succeeded before a crash, but the journal wasn't removed.
+	write("updated.bin", "new")
+	if err := writeManagedJSON(receipt+".revision", update); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.finishManagedRevision(receipt, input); err != nil {
+		t.Fatal(err)
+	}
+	retained, err := os.ReadFile(filepath.Join(destination, "updated.bin"))
+	if err != nil || string(retained) != "new" {
+		t.Fatalf("a committed revision was reset again: %q, %v", retained, err)
+	}
+}
