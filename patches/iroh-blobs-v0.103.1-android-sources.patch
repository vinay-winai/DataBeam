+/// A duplicated descriptor shares its seek cursor with its original. Hashing
+/// uses a private offset so other imports and range reads stay independent.
+struct SourceFileReader<'a> {
+    file: &'a File,
+    offset: u64,
+    size: u64,
+}
+
+impl io::Read for SourceFileReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let length = self.size.saturating_sub(self.offset).min(buf.len() as u64) as usize;
+        let count = bao_tree::io::sync::ReadAt::read_at(self.file, self.offset, &mut buf[..length])?;
+        self.offset += count as u64;
+        Ok(count)
+    }
+}
