+package croc
+import("context";"errors";"testing";"time")
+func TestDataBeamProbePortsRejectsPartialLocalConnectivity(t *testing.T){
+ if dataBeamProbePorts(context.Background(),"192.168.1.64",[]string{"9010","9011"},func(_ context.Context,a string)error{if a=="192.168.1.64:9011"{return errors.New("blocked")};return nil}){t.Fatal("accepted blocked data port")}
+ if !dataBeamProbePorts(context.Background(),"192.168.1.64",[]string{"9010","9011"},func(context.Context,string)error{return nil}){t.Fatal("rejected reachable data ports")}
+ ctx,cancel:=context.WithCancel(context.Background());cancel()
+ start:=time.Now();if dataBeamProbePorts(ctx,"127.0.0.1",[]string{"9010"},func(c context.Context,_ string)error{<-c.Done();return c.Err()}){t.Fatal("ignored cancel")};if time.Since(start)>time.Second{t.Fatal("unbounded check")}
+}
