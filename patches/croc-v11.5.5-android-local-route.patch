@@ -0,0 +1,44 @@
+package croc
+
+import (
+ "context"
+ "crypto/rand"
+ "fmt"
+ "net"
+ "runtime"
+ "strings"
+ "time"
+ "github.com/schollz/croc/v11/src/tcp"
+)
+
+// Probe a separate disposable room before joining the sender's real local room.
+// Closing a failed real-room attempt can otherwise terminate its sender.
+func dataBeamLocalRouteUsable(ctx context.Context, address, password string) bool {
+ if runtime.GOOS != "android" { return true }
+ host, _, err := net.SplitHostPort(address)
+ if err != nil { return true }
+ ip := net.ParseIP(strings.Split(host, "%")[0])
+ if ip == nil || !(ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast()) { return true }
+ probeCtx, cancel := context.WithTimeout(ctx, 1500*time.Millisecond)
+ defer cancel()
+ nonce := make([]byte, 12)
+ if _, err := rand.Read(nonce); err != nil { return false }
+ conn, banner, _, _, err := tcp.ConnectToTCPServerControlContext(probeCtx, address, password, fmt.Sprintf("databeam-probe-%x", nonce), time.Second)
+ if err != nil { return false }
+ defer conn.Close()
+ return dataBeamProbePorts(probeCtx, host, strings.Split(banner, ","), func(ctx context.Context, address string) error {
+  conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", address)
+  if err == nil { conn.Close() }
+  return err
+ })
+}
+
+func dataBeamProbePorts(ctx context.Context, host string, ports []string, dial func(context.Context,string)error) bool {
+ if len(ports)==0 || len(ports)>8 { return false }
+ ctx,cancel:=context.WithTimeout(ctx,time.Second)
+ defer cancel()
+ results:=make(chan error,len(ports))
+ for _,port:=range ports { go func(p string){results<-dial(ctx,net.JoinHostPort(host,p))}(port) }
+ for range ports { select { case err:=<-results: if err!=nil{return false};case <-ctx.Done():return false } }
+ return true
+}
