--- /dev/null
+++ b/src/croc/databeam_managed_receive.go
@@ -0,0 +1,203 @@
+package croc
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"reflect"
+	"sort"
+)
+
+type managedItem struct {
+	Path   string `json:"path"`
+	Size   int64  `json:"size"`
+	Kind   string `json:"kind"`
+	Digest []byte `json:"digest,omitempty"`
+}
+
+type managedReceipt struct {
+	Version   int           `json:"version"`
+	Entries   []managedItem `json:"entries"`
+	Algorithm string        `json:"algorithm"`
+	Strong    bool          `json:"strong"`
+	Total     int64         `json:"total"`
+	Wrapper   string        `json:"wrapper"`
+}
+
+func managedFullHash(algorithm string) bool {
+	return algorithm == "xxhash" || algorithm == "md5" || algorithm == "highway"
+}
+
+func (c *Client) recordManagedOffer() error {
+	file := os.Getenv("DATABEAM_CROC_RECEIPT")
+	if file == "" {
+		return nil
+	}
+	if c.Options.SendingText {
+		if _, err := os.Stat(file); err == nil {
+			return errors.New("The sender is sharing different files. The saved partial transfer was kept.")
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		return nil
+	}
+	r := managedReceipt{Version: 1, Strong: true}
+	topSizes := make(map[string]int64)
+	var topOrder []string
+	add := func(item managedItem) {
+		r.Entries = append(r.Entries, item)
+		root, _, _ := bytes.Cut([]byte(item.Path), []byte("/"))
+		key := string(root)
+		if _, ok := topSizes[key]; !ok {
+			topOrder = append(topOrder, key)
+		}
+		topSizes[key] += item.Size
+		r.Total += item.Size
+	}
+	for _, f := range c.FilesToTransfer {
+		if f.Symlink != "" || f.TempFile {
+			return errors.New("DataBeam Croc receive requires regular files and folders")
+		}
+		if f.Size > 0 && len(f.DataBeamDigest) != sha256.Size {
+			r.Strong = false
+		}
+	}
+	r.Algorithm = "sha256"
+	if !r.Strong {
+		r.Algorithm = c.Options.HashAlgorithm
+	}
+	for _, f := range c.FilesToTransfer {
+		digest := f.DataBeamDigest
+		if !r.Strong {
+			digest = f.Hash
+		}
+		if f.Size == 0 {
+			digest = nil
+		}
+		add(managedItem{Path: path.Join(f.FolderRemote, f.Name), Size: f.Size, Kind: "file", Digest: digest})
+	}
+	for _, f := range c.EmptyFoldersToTransfer {
+		add(managedItem{Path: f.FolderRemote, Kind: "directory"})
+	}
+	largest := ""
+	for _, k := range topOrder {
+		if largest == "" || topSizes[k] > topSizes[largest] {
+			largest = k
+		}
+	}
+	if largest == "" {
+		largest = "files"
+	}
+	name := []rune(largest)
+	if len(name) > 20 {
+		name = name[:20]
+	}
+	r.Wrapper = string(name)
+	if len(topOrder) > 1 {
+		r.Wrapper += "_and_more"
+	}
+	r.Wrapper += "_databeam"
+	sort.Slice(r.Entries, func(i, j int) bool { return r.Entries[i].Path < r.Entries[j].Path })
+	prior, err := os.ReadFile(file)
+	if err == nil {
+		var previous managedReceipt
+		if !r.Strong && (!managedFullHash(r.Algorithm) || os.Getenv("DATABEAM_CROC_REPLACEMENT_CODE") == "1") {
+			return errors.New("Cannot verify this sender's files for resume. Use the original code with a full-hash sender, or start a separate receive.")
+		}
+		if json.Unmarshal(prior, &previous) != nil || previous.Version != 1 || previous.Algorithm != r.Algorithm || !reflect.DeepEqual(previous.Entries, r.Entries) {
+			return errors.New("The sender is sharing different files. The saved partial transfer was kept.")
+		}
+		r.Wrapper = previous.Wrapper
+	} else if !os.IsNotExist(err) {
+		return err
+	} else {
+		if os.Getenv("DATABEAM_CROC_REPLACEMENT_CODE") == "1" {
+			return errors.New("No saved file list is available for this replacement code")
+		}
+		payload, err := json.Marshal(r)
+		if err != nil {
+			return err
+		}
+		if err = os.WriteFile(file+".tmp", payload, 0600); err != nil {
+			return err
+		}
+		if err = os.Rename(file+".tmp", file); err != nil {
+			return err
+		}
+	}
+	c.managedReceive = &r
+	fmt.Fprintf(os.Stderr, "\nDATABEAM_OFFER_V1 %s\n", file)
+	return nil
+}
+
+func (c *Client) verifyManagedReceive() error {
+	r := c.managedReceive
+	if r == nil {
+		return nil
+	}
+	if c.progressiveHashActive() && !r.Strong {
+		return nil
+	}
+	root, err := c.receiveFilesystem()
+	if err != nil {
+		return err
+	}
+	c.dataBeamVerifying()
+	for _, item := range r.Entries {
+		if item.Kind != "file" {
+			continue
+		}
+		f, err := root.Open(item.Path)
+		if err != nil {
+			return err
+		}
+		info, err := f.Stat()
+		if err != nil || !info.Mode().IsRegular() || info.Size() != item.Size {
+			f.Close()
+			return fmt.Errorf("Received file has unexpected size or type: %s", item.Path)
+		}
+		var digest []byte
+		if item.Size > 0 && r.Strong {
+			h := sha256.New()
+			_, err = io.Copy(h, managedVerifyReader{ctx: c.clientContext().Done(), reader: f})
+			digest = h.Sum(nil)
+		}
+		if closeErr := f.Close(); err == nil {
+			err = closeErr
+		}
+		if item.Size > 0 && !r.Strong && len(item.Digest) > 0 && err == nil {
+			digest, err = receiveFileHash(c.clientContext(), filepath.Join(root.Name(), filepath.FromSlash(item.Path)), r.Algorithm, false)
+		}
+		if err != nil {
+			return err
+		}
+		if len(item.Digest) > 0 && !bytes.Equal(item.Digest, digest) {
+			// Do not keep a corrupt file as a resume source. Other verified files remain.
+			if err = root.Remove(item.Path); err != nil {
+				return err
+			}
+			return fmt.Errorf("Verification failed for %s. Resume to download it again.", item.Path)
+		}
+	}
+	return nil
+}
+
+type managedVerifyReader struct {
+	ctx    <-chan struct{}
+	reader io.Reader
+}
+
+func (r managedVerifyReader) Read(p []byte) (int, error) {
+	select {
+	case <-r.ctx:
+		return 0, errors.New("verification cancelled")
+	default:
+		return r.reader.Read(p)
+	}
+}
