@@ -0,0 +1,54 @@
+package croc
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"testing"
+
+	"github.com/schollz/croc/v11/src/comm"
+)
+
+func TestLocalProbeResponseSkipsRelayKeepalives(t *testing.T) {
+	for _, payload := range [][]byte{
+		[]byte(`{"Kind":"pake2","Version":2}`),
+		{0x80, 0x02, 0x01, 0xff}, // encrypted endpoint response remains opaque
+	} {
+		left, right := net.Pipe()
+		reader, writer := comm.New(left), comm.New(right)
+		done := make(chan error, 1)
+		go func() {
+			defer writer.Close()
+			for _, frame := range [][]byte{{1}, {1}, payload} {
+				if err := writer.Send(frame); err != nil {
+					done <- err
+					return
+				}
+			}
+			done <- nil
+		}()
+		got, err := receiveLocalProbeResponse(reader)
+		reader.Close()
+		if err != nil || !bytes.Equal(got, payload) {
+			t.Fatalf("got %x, %v; want %x", got, err, payload)
+		}
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestLocalProbeResponseReturnsDisconnectAfterKeepalive(t *testing.T) {
+	left, right := net.Pipe()
+	reader, writer := comm.New(left), comm.New(right)
+	defer reader.Close()
+	go func() {
+		defer writer.Close()
+		_ = writer.Send([]byte{1})
+	}()
+	_, err := receiveLocalProbeResponse(reader)
+	if !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("got %v; want a closed connection error", err)
+	}
+}
