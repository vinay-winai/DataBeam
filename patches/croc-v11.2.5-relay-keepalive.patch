+package croc
+
+import "testing"
+
+func TestDataBeamRouteFormatting(t *testing.T) {
+	for _, tc := range []struct {
+		sender, direct    bool
+		local, peer, want string
+	}{
+		{true, false, "192.168.1.2:9009", "203.0.113.1:9009", "->203.0.113.1"},
+		{false, false, "192.168.1.2", "192.168.1.3", "<-192.168.1.3"},
+		{true, true, "192.168.1.2:9009", "192.168.1.3:9009", "192.168.1.2->192.168.1.3"},
+		{false, true, "[fe80::1]:9009", "[fe80::2]:9009", "fe80::1<-fe80::2"},
+		{false, true, "", "192.168.1.3", "local<-192.168.1.3"},
+	} {
+		if got := formatDataBeamTransferDirection(tc.sender, tc.direct, tc.local, tc.peer); got != tc.want {
+			t.Errorf("got %q, want %q", got, tc.want)
+		}
+	}
+}
+
+func TestDataBeamRouteTracksSelectedConnection(t *testing.T) {
+	c := &Client{}
+	c.ExternalIP = "192.168.1.2"
+	c.ExternalIPConnected = "192.168.1.3"
+	c.setRelayControlAddress("192.168.1.3:9009")
+	if c.usesDirectRelayControl() {
+		t.Fatal("a private custom relay must not be inferred to be direct")
+	}
+	c.rememberDirectRelayControlAddress("192.168.1.3:9009")
+	if got := c.transferDirection(); got != "192.168.1.2<-192.168.1.3" {
+		t.Fatalf("direct route: %s", got)
+	}
+	c.setRelayControlAddress("203.0.113.1:9009")
+	if got := c.transferDirection(); got != "<-192.168.1.3" {
+		t.Fatalf("relay fallback must clear the direct display: %s", got)
+	}
+	c.setRelayControlAddress("192.168.1.3:9009")
+	if !c.usesDirectRelayControl() {
+		t.Fatal("reconnecting to the known direct route must preserve its display")
+	}
+}
