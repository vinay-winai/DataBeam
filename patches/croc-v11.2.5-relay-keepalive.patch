+package croc
+
+// Record only routes selected by LAN discovery/probing or the sender's own
+// local relay. A private address alone does not make a custom relay direct.
+func (c *Client) rememberDirectRelayControlAddress(address string) {
+	c.reconnectRelayMu.Lock()
+	defer c.reconnectRelayMu.Unlock()
+	c.directControlAddress = normalizeRelayAddress(address)
+}
+
+func (c *Client) usesDirectRelayControl() bool {
+	c.reconnectRelayMu.Lock()
+	defer c.reconnectRelayMu.Unlock()
+	return c.directControlAddress != "" &&
+		c.relayControlAddress == c.directControlAddress
+}
+
+// Match the newer CLI's display shape without changing transfer negotiation.
+func formatDataBeamTransferDirection(sender, direct bool, local, peer string) string {
+	local, peer = peerIP(local), peerIP(peer)
+	arrow := "<-"
+	if sender {
+		arrow = "->"
+	}
+	if !direct {
+		return arrow + peer
+	}
+	if local == "" {
+		local = "local"
+	}
+	return local + arrow + peer
+}
+
+func (c *Client) transferDirection() string {
+	direct := c.usesDirectRelayControl()
+	local := c.ExternalIP
+	if direct && len(c.conn) > 0 && c.conn[0] != nil {
+		local = c.conn[0].Connection().LocalAddr().String()
+	}
+	return formatDataBeamTransferDirection(c.Options.IsSender, direct, local, c.ExternalIPConnected)
+}
