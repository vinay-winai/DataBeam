+// receiveLocalProbeResponse waits for the peer's local-probe reply. Relays
+// may send keepalives while the other peer has not joined the room yet.
+// They are transport frames, not PAKE or encrypted local-endpoint replies.
+func receiveLocalProbeResponse(conn *comm.Comm) ([]byte, error) {
+	for {
+		data, err := conn.Receive()
+		if err != nil {
+			return nil, err
+		}
+		if bytes.Equal(data, []byte{1}) {
+			log.Trace("got ping during local probe")
+			continue
+		}
+		return data, nil
+	}
+}
