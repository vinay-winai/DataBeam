@@ -0,0 +1,70 @@
+package utils
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func openDataBeamDescriptor(path, id string) (*os.File, error) {
+	fail := func(reason error) (*os.File, error) {
+		return nil, fmt.Errorf("could not read selected Android file %q: %w", path, reason)
+	}
+	requested, err := strconv.ParseUint(id, 10, 31)
+	broker := os.Getenv("DATABEAM_ANDROID_SOURCE_BROKER")
+	if err != nil || !strings.HasPrefix(broker, "databeam-croc-") {
+		return fail(os.ErrInvalid)
+	}
+	conn, err := net.DialTimeout("unix", "@"+broker, 3*time.Second)
+	if err != nil {
+		return fail(err)
+	}
+	defer conn.Close()
+	socket := conn.(*net.UnixConn)
+	if err := socket.SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		return fail(err)
+	}
+	var request [4]byte
+	binary.BigEndian.PutUint32(request[:], uint32(requested))
+	if _, err := socket.Write(request[:]); err != nil {
+		return fail(err)
+	}
+	var response [1]byte
+	control := make([]byte, unix.CmsgSpace(4))
+	n, controlSize, flags, _, err := socket.ReadMsgUnix(response[:], control)
+	if err != nil {
+		return fail(err)
+	}
+	messages, err := unix.ParseSocketControlMessage(control[:controlSize])
+	if err != nil {
+		return fail(err)
+	}
+	var descriptors []int
+	for _, message := range messages {
+		fds, err := unix.ParseUnixRights(&message)
+		if err == nil {
+			descriptors = append(descriptors, fds...)
+		}
+	}
+	if n != 1 || response[0] != 1 || flags&unix.MSG_CTRUNC != 0 || len(descriptors) != 1 {
+		for _, fd := range descriptors {
+			_ = unix.Close(fd)
+		}
+		return fail(os.ErrPermission)
+	}
+	fd := descriptors[0]
+	unix.CloseOnExec(fd)
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		file.Close()
+		return fail(os.ErrInvalid)
+	}
+	return file, nil
+}
